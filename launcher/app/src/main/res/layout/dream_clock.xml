<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream): iPhone Weather style. Sky gradient, current conditions on the left,
     hourly and daily cards on the right, clock in the corner. Falls back to the clock on black. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dreamRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Everything drifts a few dp each minute so nothing burns in. -->
    <FrameLayout
        android:id="@+id/dreamContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="40dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#F2FFFFFF"
                android:textSize="34sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 300"
                android:includeFontPadding="false" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:format12Hour="EEEE, d MMMM"
                android:format24Hour="EEEE, d MMMM"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <!-- Current conditions, iPhone header style. -->
        <LinearLayout
            android:id="@+id/wxNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/wxCity"
                style="@style/WeatherText"
                android:textSize="26sp"
                android:fontVariationSettings="'wght' 400" />

            <TextView
                android:id="@+id/wxTemp"
                style="@style/WeatherText"
                android:layout_marginStart="16dp"
                android:textSize="92sp"
                android:fontVariationSettings="'wght' 150"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/wxCond"
                style="@style/WeatherText"
                android:textSize="19sp"
                android:textColor="#D9FFFFFF" />

            <TextView
                android:id="@+id/wxRange"
                style="@style/WeatherText"
                android:layout_marginTop="2dp"
                android:textSize="17sp"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/wxExtra"
                style="@style/WeatherText"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:textColor="#B3FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wxCards"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/weather_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/WeatherCaption"
                    android:text="ПОЧАСОВОЙ ПРОГНОЗ" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="#26FFFFFF" />

                <LinearLayout
                    android:id="@+id/wxHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/weather_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/WeatherCaption"
                    android:text="ПРОГНОЗ НА 6 ДНЕЙ" />

                <LinearLayout
                    android:id="@+id/wxDays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
