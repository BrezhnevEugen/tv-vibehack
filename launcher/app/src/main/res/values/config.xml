<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>watch.kino.plus</item>
        <item>ru.kinopoisk.tv</item>
        <item>com.apple.atve.androidtv.appletv</item>
    </string-array>

    <!-- Apps placed right after the HDMI / Weather / TV channels tiles. -->
    <string-array name="front_apps">
        <item>com.infolink.limeiptv</item>
        <item>com.biglybt.android.client</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.tcl.tv</item>
        <item>com.tcl.t_solo</item>
        <item>com.esaba.downloader</item>
        <item>com.tcl.ui_mediaCenter</item>
        <item>com.tcl.partnercustomizer</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.tcl.tv</string>

    <!-- Remote buttons sent to another app, "keycode=package". 4062 = Netflix, 4065 = YouTube buttons on TCL remotes. -->
    <string-array name="key_remaps">
        <item>4062=watch.kino.plus</item>
        <item>4065=com.google.android.youtube.tv</item>
    </string-array>

    <!-- Screensaver weather (Open-Meteo, no key). -->
    <string name="weather_city" translatable="false">Краснодар</string>
    <string name="weather_lat" translatable="false">45.0355</string>
    <string name="weather_lon" translatable="false">38.9753</string>

    <!-- TV channels tile: playlists from iptv-org (public, free streams) and the channels to take from them,
         "tvg-id[@variant][,other-id…]|Name" in order. Missing ones are skipped. -->
    <string-array name="iptv_playlists">
        <item>https://raw.githubusercontent.com/Free-TV/IPTV/master/playlists/playlist_russia.m3u8</item>
        <item>https://iptv-org.github.io/iptv/countries/ru.m3u</item>
        <item>https://iptv-org.github.io/iptv/categories/news.m3u</item>
    </string-array>
    <!-- Extra known streams (official sites), checked first: "tvg-id|url[|referer]". -->
    <string-array name="iptv_extra">
        <item>Russia24|https://live.smotrim.ru/vgtrk/0/russia24-hd/index.m3u8</item>
