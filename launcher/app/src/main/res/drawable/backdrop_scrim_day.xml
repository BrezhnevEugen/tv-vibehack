<?xml version="1.0" encoding="utf-8"?>
<!-- backdrop_scrim for the day look: fades the artwork into the light background on the left and at the bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><gradient android:angle="0" android:startColor="#F2EEF1F5" android:centerColor="#80EEF1F5" android:endColor="#00EEF1F5" /></shape>
    </item>
    <item>
        <shape><gradient android:angle="90" android:startColor="#FFDCE1E8" android:centerColor="#66DCE1E8" android:endColor="#00DCE1E8" /></shape>
    </item>
    <item>
        <shape><gradient android:angle="270" android:startColor="#99F4F6F9" android:endColor="#00F4F6F9" android:type="linear" /></shape>
    </item>
</layer-list>
