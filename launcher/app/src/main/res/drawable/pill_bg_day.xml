<?xml version="1.0" encoding="utf-8"?>
<!-- pill_bg for the day look: dark when focused, a faint grey glass otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F21C1C1E" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1A000000" android:endColor="#0D000000" />
            <stroke android:width="1dp" android:color="#24000000" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
